<div class="page-header d-flex justify-content-between align-items-center">
  <h2>Daftar Produk</h2>
  <a href="/produk/add" class="btn btn-primary">
    <i class="bi bi-plus"></i> Tambah Produk
  </a>
</div>

<div class="table-responsive">
  <table class="table table-hover">
    <thead class="table-dark">
      <tr>
        <th>No</th>
        <th>Nama Produk</th>
        <th>Harga</th>
        <th>Kategori</th>
        <th>Status</th>
        <th class="text-center">Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% produk.forEach((item, index) => { %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= item.nama_produk %></td>
        <td>Rp <%= item.harga.toLocaleString('id-ID') %></td>
        <td><%= item.Kategori.nama_kategori %></td>
        <td>
          <span
            class="badge <%= item.Status.nama_status === 'bisa dijual' ? 'bg-success' : 'bg-danger' %>"
          >
            <%= item.Status.nama_status %>
          </span>
        </td>
        <td class="text-center">
          <a
            href="/produk/edit/<%= item.id %>"
            class="btn btn-warning btn-sm btn-action"
          >
            <i class="bi bi-pencil"></i> Edit
          </a>
          <form
            action="/produk/delete/<%= item.id %>"
            method="POST"
            class="d-inline"
          >
            <button
              type="submit"
              class="btn btn-danger btn-sm btn-action"
              onclick="return confirm('Apakah Anda yakin ingin menghapus produk ini?')"
            >
              <i class="bi bi-trash"></i> Hapus
            </button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (produk.length === 0) { %>
<div class="alert alert-info text-center">Tidak ada produk yang tersedia.</div>
<% } %>
